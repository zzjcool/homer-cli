{
  "name": "exclude-push-placeholder-replacement",
  "operation": "applyExcludeKeyPlaceholders",
  "input": {
    "config": {
      "version": 1,
      "adapters": {
        "pi": {
          "root": "/tmp/homer-golden/pi",
          "categories": {
            "models": {
              "paths": [
                "models.json"
              ],
              "mode": "merge",
              "excludeKeys": [
                "apiKeys"
              ]
            }
          }
        }
      }
    },
    "snapshot": [
      {
        "adapterId": "pi",
        "categories": [
          {
            "adapterId": "pi",
            "category": "models",
            "mode": "merge",
            "files": {
              "models.json": {
                "kind": "json",
                "content": "{\"apiKeys\":\"local-test-key\",\"provider\":\"test-provider\"}"
              }
            }
          }
        ]
      }
    ]
  },
  "output": [
    {
      "adapterId": "pi",
      "categories": [
        {
          "adapterId": "pi",
          "category": "models",
          "mode": "merge",
          "files": {
            "models.json": {
              "kind": "json",
              "content": "{\n  \"apiKeys\": \"__REQUIRED__\",\n  \"provider\": \"test-provider\"\n}\n"
            }
          }
        }
      ]
    }
  ]
}
