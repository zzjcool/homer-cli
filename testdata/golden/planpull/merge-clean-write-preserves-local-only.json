{
  "name": "merge-clean-write-preserves-local-only",
  "operation": "planPull",
  "input": {
    "config": {
      "version": 1,
      "adapters": {
        "pi": {
          "root": "/tmp/homer-golden/pi",
          "categories": {
            "settings": {
              "paths": [
                "settings.json"
              ],
              "mode": "merge"
            }
          }
        }
      }
    },
    "base": [
      {
        "adapterId": "pi",
        "categories": [
          {
            "adapterId": "pi",
            "category": "settings",
            "mode": "merge",
            "files": {
              "settings.json": {
                "kind": "json",
                "content": "{\"theme\":\"light\",\"keep\":1}"
              }
            }
          }
        ]
      }
    ],
    "local": [
      {
        "adapterId": "pi",
        "categories": [
          {
            "adapterId": "pi",
            "category": "settings",
            "mode": "merge",
            "files": {
              "settings.json": {
                "kind": "json",
                "content": "{\"theme\":\"light\",\"keep\":1,\"localOnly\":true}"
              }
            }
          }
        ]
      }
    ],
    "remote": [
      {
        "adapterId": "pi",
        "categories": [
          {
            "adapterId": "pi",
            "category": "settings",
            "mode": "merge",
            "files": {
              "settings.json": {
                "kind": "json",
                "content": "{\"theme\":\"dark\",\"keep\":1}"
              }
            }
          }
        ]
      }
    ]
  },
  "output": {
    "actions": [
      {
        "type": "write",
        "adapterId": "pi",
        "category": "settings",
        "relPath": "settings.json",
        "content": "{\n  \"theme\": \"dark\",\n  \"keep\": 1,\n  \"localOnly\": true\n}\n"
      }
    ]
  }
}
